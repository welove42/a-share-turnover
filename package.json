{
  "name": "a-share-turnover",
  "displayName": "A股行情 · 自选股、基金与全球指数",
  "description": "沪深成交额同刻对比、自选股、基金收益、全球指数与黄金原油铜银等商品参考行情，以及行情图表和财经快讯。",
  "version": "1.9.0",
  "publisher": "welove42",
  "icon": "media/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "A股",
    "自选股",
    "上证指数",
    "成交额",
    "财经新闻",
    "股票",
    "ETF",
    "全球指数",
    "日经",
    "纳斯达克",
    "基金",
    "基金收益",
    "黄金",
    "原油",
    "伦敦铜",
    "白银"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.js",
    "package": "vsce package --no-dependencies --out ../a-share-turnover-1.9.0.vsix",
    "smoke:stocks": "node scripts/smoke-stocks.js",
    "smoke:news": "node scripts/smoke-news.js",
    "smoke:charts": "node scripts/smoke-charts.js",
    "smoke:global": "node scripts/smoke-global.js",
    "smoke:funds": "node scripts/smoke-funds.js",
    "smoke:commodities": "node scripts/smoke-commodities.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "welove42.aShareTurnover.refresh",
        "title": "A股成交额：立即刷新"
      },
      {
        "command": "welove42.aShareTurnover.showMenu",
        "title": "A股成交额：打开菜单"
      },
      {
        "command": "welove42.aShareTurnover.togglePause",
        "title": "A股成交额：暂停 / 恢复自动刷新"
      },
      {
        "command": "welove42.aShareTurnover.switchComparison",
        "title": "A股成交额：切换比较口径"
      },
      {
        "command": "welove42.aShareTurnover.showLog",
        "title": "A股成交额：查看日志"
      },
      {
        "command": "welove42.aShareTurnover.stocks.add",
        "title": "A股自选股：搜索名称或代码并添加",
        "icon": "$(add)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.remove",
        "title": "A股自选股：删除自选股",
        "icon": "$(trash)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.refresh",
        "title": "A股自选股：立即刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.selectStatus",
        "title": "A股自选股：选择底部显示的指数或个股",
        "icon": "$(pin)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.sort",
        "title": "A股自选股：切换排序",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.togglePause",
        "title": "A股自选股：暂停 / 恢复自动刷新",
        "icon": "$(debug-pause)"
      },
      {
        "command": "welove42.aShareTurnover.news.refresh",
        "title": "A股财经新闻：立即刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.news.show",
        "title": "A股财经新闻：打开资讯面板",
        "icon": "$(megaphone)"
      },
      {
        "command": "welove42.aShareTurnover.news.open",
        "title": "A股财经新闻：阅读全文",
        "icon": "$(open-preview)"
      },
      {
        "command": "welove42.aShareTurnover.news.source",
        "title": "A股财经新闻：选择来源",
        "icon": "$(list-selection)"
      },
      {
        "command": "welove42.aShareTurnover.news.setToken",
        "title": "A股财经新闻：设置选股宝 Token",
        "icon": "$(key)"
      },
      {
        "command": "welove42.aShareTurnover.news.togglePause",
        "title": "A股财经新闻：暂停 / 恢复自动刷新",
        "icon": "$(debug-pause)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.openChart",
        "title": "A股自选股：查看详细行情图表",
        "icon": "$(graph-line)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.openInBrowser",
        "title": "A股自选股：在浏览器打开东方财富",
        "icon": "$(link-external)"
      },
      {
        "command": "welove42.aShareTurnover.chart.selectMode",
        "title": "A股图表：切换图表类型",
        "shortTitle": "切换图表类型",
        "icon": "$(graph-line)"
      },
      {
        "command": "welove42.aShareTurnover.chart.selectIndicator",
        "title": "A股图表：切换技术指标",
        "shortTitle": "切换技术指标",
        "icon": "$(pulse)"
      },
      {
        "command": "welove42.aShareTurnover.chart.refresh",
        "title": "A股图表：刷新当前图表",
        "shortTitle": "刷新当前图表",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.chart.openInBrowser",
        "title": "A股图表：在浏览器打开当前图表",
        "shortTitle": "在浏览器打开当前图表",
        "icon": "$(link-external)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.search",
        "title": "全球指数：搜索并添加指数",
        "icon": "$(search)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.refresh",
        "title": "全球指数：立即刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.togglePause",
        "title": "全球指数：暂停 / 恢复自动刷新",
        "icon": "$(debug-pause)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.open",
        "title": "全球指数：在浏览器查看指数详情",
        "icon": "$(link-external)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.add",
        "title": "全球指数：添加指数（名称 / 代码）",
        "icon": "$(add)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.remove",
        "title": "全球指数：删除指数",
        "icon": "$(trash)"
      },
      {
        "command": "welove42.aShareTurnover.funds.add",
        "title": "基金：按名称或代码添加基金",
        "icon": "$(add)"
      },
      {
        "command": "welove42.aShareTurnover.funds.refresh",
        "title": "基金：立即检查净值",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.funds.togglePause",
        "title": "基金：暂停 / 恢复自动检查",
        "icon": "$(debug-pause)"
      },
      {
        "command": "welove42.aShareTurnover.funds.remove",
        "title": "基金：移出列表（保留持仓记录）",
        "icon": "$(trash)"
      },
      {
        "command": "welove42.aShareTurnover.funds.editHolding",
        "title": "基金：设置持仓份额和总成本",
        "icon": "$(edit)"
      },
      {
        "command": "welove42.aShareTurnover.funds.clearHolding",
        "title": "基金：清除本机持仓（保留关注）",
        "icon": "$(clear-all)"
      },
      {
        "command": "welove42.aShareTurnover.funds.open",
        "title": "基金：在浏览器查看基金详情",
        "icon": "$(link-external)"
      },
      {
        "command": "welove42.aShareTurnover.commodities.add",
        "title": "全球商品：按名称或代码添加商品",
        "icon": "$(add)"
      },
      {
        "command": "welove42.aShareTurnover.commodities.remove",
        "title": "全球商品：移除商品",
        "icon": "$(trash)"
      },
      {
        "command": "welove42.aShareTurnover.commodities.refresh",
        "title": "全球商品：立即刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.commodities.togglePause",
        "title": "全球商品：暂停 / 恢复自动刷新",
        "icon": "$(debug-pause)"
      },
      {
        "command": "welove42.aShareTurnover.commodities.open",
        "title": "全球商品：在浏览器查看商品详情",
        "icon": "$(link-external)"
      }
    ],
    "configuration": {
      "title": "A股成交额",
      "properties": {
        "aShareTurnover.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "在底部状态栏显示沪深 A 股成交额。"
        },
        "aShareTurnover.comparisonMode": {
          "type": "string",
          "enum": [
            "sameTime",
            "previousDay"
          ],
          "default": "sameTime",
          "scope": "application",
          "enumDescriptions": [
            "与上一交易日相同分钟的累计成交额比较。",
            "与上一交易日全天成交额比较，明确标注较昨全天。"
          ],
          "description": "状态栏的缩量 / 放量比较口径。"
        },
        "aShareTurnover.showDifferenceAmount": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "在状态栏百分比后同时显示增加 / 减少的成交额。"
        },
        "aShareTurnover.colorMode": {
          "type": "string",
          "enum": [
            "neutral",
            "redUpGreenDown"
          ],
          "default": "neutral",
          "scope": "application",
          "enumDescriptions": [
            "使用默认状态栏颜色。",
            "放量红色，缩量绿色。"
          ],
          "description": "缩放量文字颜色。"
        },
        "aShareTurnover.additionalClosedDates": {
          "type": "array",
          "default": [],
          "scope": "application",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "description": "额外休市日期（YYYY-MM-DD），用于补充未来年份或临时休市。内置 2026 年交易所节假日。周末始终休市，不跟随调休补班。"
        },
        "aShareTurnover.stocks.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "显示自选股侧栏及底部指数/个股行情，与原成交额状态栏独立。"
        },
        "aShareTurnover.stocks.symbols": {
          "type": "array",
          "default": [],
          "scope": "application",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "自选代码，最多100个。点击添加可按中文名、拼音或编号搜索；设置中保存完整代码，如 sh600519、sz000001、bj920002。"
        },
        "aShareTurnover.stocks.statusBarSymbol": {
          "type": "string",
          "default": "sh000001",
          "scope": "application",
          "description": "底部显示的代码，默认上证指数；其他代码须已加入自选。点击底部行情可切换，删除已选个股后自动回到上证指数。"
        },
        "aShareTurnover.stocks.sortBy": {
          "type": "string",
          "enum": [
            "manual",
            "percentDesc",
            "percentAsc"
          ],
          "default": "manual",
          "scope": "application",
          "enumDescriptions": [
            "按添加顺序",
            "涨幅从高到低",
            "跌幅从大到小"
          ],
          "description": "自选股列表排序。"
        },
        "aShareTurnover.charts.defaultMode": {
          "type": "string",
          "enum": [
            "intraday",
            "m1",
            "m5",
            "m15",
            "m30",
            "m60",
            "daily",
            "weekly",
            "monthly",
            "eastmoney",
            "chips"
          ],
          "default": "intraday",
          "scope": "application",
          "enumDescriptions": [
            "内置分时图，直接绘制价格、成交量及技术指标。",
            "内置1分钟K线。",
            "内置5分钟K线。",
            "内置15分钟K线。",
            "内置30分钟K线。",
            "内置60分钟K线。",
            "内置日K、均线及技术指标。",
            "内置周K、均线及技术指标。",
            "内置月K、均线及技术指标。",
            "东方财富常规网页图表，可能要求验证码。",
            "东方财富筹码盘口网页，可能要求验证码；不支持的品种使用内置分时。"
          ],
          "description": "新打开详情标签的默认图表。已有标签切换股票时保留当前类型；可用编辑器右上角切换图表。"
        },
        "aShareTurnover.news.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "启用底部输出面板财经快讯及新闻状态栏入口。"
        },
        "aShareTurnover.news.source": {
          "type": "string",
          "enum": [
            "eastmoney",
            "xuangubao"
          ],
          "default": "eastmoney",
          "scope": "application",
          "enumDescriptions": [
            "东方财富公开快讯，无需登录",
            "选股宝（参考插件来源），需要设置登录Token"
          ],
          "description": "财经新闻来源；选股宝Token请使用命令设置，保存在SecretStorage。"
        },
        "aShareTurnover.news.refreshIntervalSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 10,
          "maximum": 300,
          "scope": "application",
          "description": "7×24快讯刷新间隔（秒），休市期间也刷新。支持暂停，默认不弹出桌面通知。"
        },
        "aShareTurnover.globalIndices.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "显示自选股下方的全球指数栏目。默认仅纳斯达克综合、日经225和韩国KOSPI，其他指数通过＋添加；栏目可见时每10秒刷新所选指数，主源失败自动回退，全源失败逐步退避；不受A股交易时段限制。"
        },
        "aShareTurnover.globalIndices.symbols": {
          "type": "array",
          "default": [
            "100.NDX",
            "100.N225",
            "100.KS11"
          ],
          "scope": "application",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:100\\.)?[A-Za-z][A-Za-z0-9]{0,19}$"
          },
          "description": "全球指数显示列表，按添加顺序排列。点击栏目＋搜索名称或代码添加，行末垃圾桶删除；也可填代码如 NDX、N225、KS11、100.SPX。空数组表示不显示任何指数。"
        },
        "aShareTurnover.funds.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "显示基金折叠栏目。展示已公布净值与涨跌，支持本机持仓收益；可见时每60秒检查净值。"
        },
        "aShareTurnover.funds.symbols": {
          "type": "array",
          "default": [],
          "scope": "application",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "description": "关注的六位基金代码，默认不预置基金；可通过＋按名称或代码搜索添加。持仓份额与成本保存在本机扩展存储，不写入此设置。"
        },
        "aShareTurnover.commodities.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "显示全球商品折叠栏目，展开时每10秒获取新浪财经CFD参考行情，不受A股开盘时间限制。"
        },
        "aShareTurnover.commodities.symbols": {
          "type": "array",
          "default": [
            "XAU",
            "OIL",
            "CAD",
            "XAG"
          ],
          "scope": "application",
          "uniqueItems": true,
          "maxItems": 14,
          "items": {
            "type": "string"
          },
          "description": "默认仅伦敦金、布伦特原油、伦敦铜、伦敦银，顺序按此列表保存。点击＋可按名称、拼音简称或代码从支持的商品目录添加其他品种；代码支持XAU或hf_XAU格式。空数组保持空列表。"
        },
        "aShareTurnover.risk.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "状态栏显示基于沪深成交额较昨同刻与上证指数跌幅的风险提示；依赖成交额及自选股行情模块。"
        },
        "aShareTurnover.risk.volumePercent": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 1000,
          "scope": "application",
          "description": "触发放量或缩量下跌提示所需的同刻成交额变化绝对值（百分比）。"
        },
        "aShareTurnover.risk.dropPercent": {
          "type": "number",
          "default": 1.5,
          "minimum": 0.1,
          "maximum": 100,
          "scope": "application",
          "description": "触发提示所需的上证指数跌幅（百分比）。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "welove42Market",
          "title": "STOCK · A股行情",
          "icon": "media/market.svg"
        }
      ]
    },
    "views": {
      "welove42Market": [
        {
          "id": "welove42.aShareTurnover.watchlist",
          "name": "自选股（名称 / 代码）",
          "contextualTitle": "STOCK 自选股"
        },
        {
          "id": "welove42.aShareTurnover.globalIndices",
          "name": "全球指数",
          "contextualTitle": "STOCK 全球指数",
          "when": "config.aShareTurnover.globalIndices.enabled"
        },
        {
          "id": "welove42.aShareTurnover.funds",
          "name": "基金",
          "contextualTitle": "STOCK 基金",
          "when": "config.aShareTurnover.funds.enabled"
        },
        {
          "id": "welove42.aShareTurnover.commodities",
          "name": "全球商品",
          "contextualTitle": "STOCK 全球商品",
          "when": "config.aShareTurnover.commodities.enabled"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "welove42.aShareTurnover.watchlist",
        "contents": "输入中文名、拼音或股票代码搜索添加自选股。\n[搜索并添加自选股](command:welove42.aShareTurnover.stocks.add)\n点击个股查看东方财富详细行情及分时 / 日K图。\n[财经新闻（底部输出面板）](command:welove42.aShareTurnover.news.show)\n底部默认显示上证指数，点击可切换。",
        "when": "config.aShareTurnover.stocks.enabled"
      },
      {
        "view": "welove42.aShareTurnover.watchlist",
        "contents": "自选行情已禁用，请在用户设置中开启 aShareTurnover.stocks.enabled。",
        "when": "!config.aShareTurnover.stocks.enabled"
      },
      {
        "view": "welove42.aShareTurnover.funds",
        "contents": "添加基金查看已公布净值和涨跌幅。\n[按名称或代码添加基金](command:welove42.aShareTurnover.funds.add)\n行末铅笔可设置份额和成本，计算个人持仓收益。\n基金净值通常按日公布，持仓数据只保存在本机。",
        "when": "config.aShareTurnover.funds.enabled"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "welove42.aShareTurnover.stocks.add",
          "when": "view == welove42.aShareTurnover.watchlist",
          "group": "navigation@0"
        },
        {
          "command": "welove42.aShareTurnover.stocks.refresh",
          "when": "view == welove42.aShareTurnover.watchlist",
          "group": "navigation@1"
        },
        {
          "command": "welove42.aShareTurnover.stocks.sort",
          "when": "view == welove42.aShareTurnover.watchlist",
          "group": "navigation@2"
        },
        {
          "command": "welove42.aShareTurnover.stocks.togglePause",
          "when": "view == welove42.aShareTurnover.watchlist",
          "group": "navigation@3"
        },
        {
          "command": "welove42.aShareTurnover.news.show",
          "when": "view == welove42.aShareTurnover.watchlist",
          "group": "news@0"
        },
        {
          "command": "welove42.aShareTurnover.globalIndices.add",
          "when": "view == welove42.aShareTurnover.globalIndices",
          "group": "navigation@0"
        },
        {
          "command": "welove42.aShareTurnover.globalIndices.refresh",
