        },
        {
          "command": "welove42.aShareTurnover.globalIndices.togglePause",
          "when": "!aShareTurnover.hidden && (view == welove42.aShareTurnover.globalIndices)",
          "group": "navigation@2"
        },
        {
          "command": "welove42.aShareTurnover.funds.add",
          "when": "!aShareTurnover.hidden && (view == welove42.aShareTurnover.funds)",
          "group": "navigation@0"
        },
        {
          "command": "welove42.aShareTurnover.funds.refresh",
