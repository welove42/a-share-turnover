        },
        {
          "command": "welove42.aShareTurnover.commodities.open",
          "when": "view == welove42.aShareTurnover.commodities && viewItem == aShareCommodity",
          "group": "navigation@0"
        },
        {
          "command": "welove42.aShareTurnover.stockGroups.create",
          "when": "view == welove42.aShareTurnover.marketWatch && !aShareTurnover.hidden && viewItem =~ /^aShare(Root|OverseasGroup)$/",
          "group": "inline@0"
        },
        {
          "command": "welove42.aShareTurnover.stockGroups.add",
          "when": "view == welove42.aShareTurnover.marketWatch && !aShareTurnover.hidden && viewItem == aShareRoot",
          "group": "inline@1"
        },
        {
          "command": "welove42.aShareTurnover.stockGroups.add",
          "when": "view == welove42.aShareTurnover.marketWatch && !aShareTurnover.hidden && viewItem =~ /^aShare(CustomGroup|Ungrouped)$/",
          "group": "inline@0"
        },
        {
          "command": "welove42.aShareTurnover.stockGroups.rename",
          "when": "view == welove42.aShareTurnover.marketWatch && !aShareTurnover.hidden && viewItem == aShareCustomGroup",
          "group": "manage@0"
        },
        {
          "command": "welove42.aShareTurnover.stockGroups.remove",
          "when": "view == welove42.aShareTurnover.marketWatch && !aShareTurnover.hidden && viewItem == aShareCustomGroup",
          "group": "manage@1"
        },
        {
          "command": "welove42.aShareTurnover.stockGroups.move",
          "when": "view == welove42.aShareTurnover.marketWatch && !aShareTurnover.hidden && viewItem =~ /^aShare(Stock|OverseasStock)$/",
          "group": "manage@0"
        },
        {
          "command": "welove42.aShareTurnover.ai.open",
          "when": "view == welove42.aShareTurnover.marketWatch && viewItem == aShareStock && !aShareTurnover.hidden",
          "group": "analysis@1"
        }
      ],
      "commandPalette": [
        {
          "command": "welove42.aShareTurnover.news.open",
          "when": "false"
        },
        {
          "command": "welove42.aShareTurnover.chart.selectMode",
          "when": "activeWebviewPanelId == welove42.aShareTurnover.stockChart"
        },
        {
          "command": "welove42.aShareTurnover.chart.refresh",
          "when": "activeWebviewPanelId == welove42.aShareTurnover.stockChart"
        },
        {
          "command": "welove42.aShareTurnover.chart.openInBrowser",
