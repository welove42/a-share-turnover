{
  "name": "a-share-turnover",
  "displayName": "牛来盯盘",
  "description": "沪深市场温度、成交额同刻对比、自选股、基金收益、全球指数与黄金原油铜银等商品参考行情，以及行情图表和财经快讯。",
  "version": "1.23.0",
  "publisher": "welove42",
  "icon": "media/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "A股",
    "自选股",
    "上证指数",
    "成交额",
    "财经新闻",
    "股票",
    "ETF",
    "全球指数",
    "日经",
    "纳斯达克",
    "基金",
    "基金收益",
    "黄金",
    "原油",
    "伦敦铜",
    "白银",
    "市场温度"
  ],
  "main": "./dist/app/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "test": "npm run build && node --test test/*.test.cts",
    "smoke": "node scripts/smoke.cts",
    "package": "vsce package --no-dependencies --out ../a-share-turnover-1.23.0.vsix",
    "smoke:stocks": "node scripts/smoke-stocks.cts",
    "smoke:news": "node scripts/smoke-news.cts",
    "smoke:charts": "node scripts/smoke-charts.cts",
    "smoke:global": "node scripts/smoke-global.cts",
    "smoke:funds": "node scripts/smoke-funds.cts",
    "smoke:commodities": "node scripts/smoke-commodities.cts",
    "smoke:temperature": "node scripts/smoke-temperature.cts",
    "build": "node scripts/build.cts",
    "typecheck": "node scripts/build.cts --check",
    "vscode:prepublish": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.cts\" \"test/*.cts\""
  },
  "contributes": {
    "commands": [
      {
        "command": "welove42.aShareTurnover.settings.open",
        "title": "牛来盯盘：打开插件设置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "welove42.aShareTurnover.toggleHidden",
        "title": "牛来盯盘：切换隐藏模式（老板键）"
      },
      {
        "command": "welove42.aShareTurnover.reminders.show",
        "title": "财经大事：查看提醒日历"
      },
      {
        "command": "welove42.aShareTurnover.refresh",
        "title": "A股成交额：立即刷新"
      },
      {
        "command": "welove42.aShareTurnover.showMenu",
        "title": "A股成交额：打开菜单"
      },
      {
        "command": "welove42.aShareTurnover.togglePause",
        "title": "A股成交额：暂停 / 恢复自动刷新"
      },
      {
        "command": "welove42.aShareTurnover.switchComparison",
        "title": "A股成交额：切换比较口径"
      },
      {
        "command": "welove42.aShareTurnover.showLog",
        "title": "A股成交额：查看日志"
      },
      {
        "command": "welove42.aShareTurnover.showTemperatureDetails",
        "title": "牛来盯盘：查看市场温度计算明细",
        "icon": "$(info)"
      },
      {
        "command": "welove42.aShareTurnover.temperature.refresh",
        "title": "市场温度：刷新行情",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.showTemperature",
        "title": "牛来盯盘：查看市场温度走势图"
      },
      {
        "command": "welove42.aShareTurnover.stocks.add",
        "title": "自选股：搜索A股、港股或美股并添加",
        "icon": "$(add)"
      },
      {
        "command": "welove42.aShareTurnover.overseas.add",
        "title": "港美股：搜索并添加",
        "icon": "$(add)"
      },
      {
        "command": "welove42.aShareTurnover.overseas.remove",
        "title": "港美股：删除自选股",
        "icon": "$(trash)"
      },
      {
        "command": "welove42.aShareTurnover.overseas.open",
        "title": "港美股：在浏览器查看行情"
      },
      {
        "command": "welove42.aShareTurnover.stocks.remove",
        "title": "A股自选股：删除自选股",
        "icon": "$(trash)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.refresh",
        "title": "A股自选股：立即刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.selectStatus",
        "title": "A股自选股：选择底部显示的指数或个股",
        "icon": "$(pin)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.sort",
        "title": "A股自选股：切换排序",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.togglePause",
        "title": "A股自选股：暂停 / 恢复自动刷新",
        "icon": "$(debug-pause)"
      },
      {
        "command": "welove42.aShareTurnover.news.refresh",
        "title": "A股财经新闻：立即刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.news.show",
        "title": "A股财经新闻：打开资讯面板",
        "icon": "$(megaphone)"
      },
      {
        "command": "welove42.aShareTurnover.news.open",
        "title": "A股财经新闻：阅读全文",
        "icon": "$(open-preview)"
      },
      {
        "command": "welove42.aShareTurnover.news.togglePause",
        "title": "A股财经新闻：暂停 / 恢复自动刷新",
        "icon": "$(debug-pause)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.openChart",
        "title": "A股自选股：查看详细行情图表",
        "icon": "$(graph-line)"
      },
      {
        "command": "welove42.aShareTurnover.stocks.openInBrowser",
        "title": "A股自选股：在浏览器打开东方财富",
        "icon": "$(link-external)"
      },
      {
        "command": "welove42.aShareTurnover.chart.selectMode",
        "title": "A股图表：切换图表类型",
        "shortTitle": "切换图表类型",
        "icon": "$(graph-line)"
      },
      {
        "command": "welove42.aShareTurnover.chart.selectIndicator",
        "title": "A股图表：切换技术指标",
        "shortTitle": "切换技术指标",
        "icon": "$(pulse)"
      },
      {
        "command": "welove42.aShareTurnover.chart.refresh",
        "title": "A股图表：刷新当前图表",
        "shortTitle": "刷新当前图表",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.chart.openInBrowser",
        "title": "A股图表：在浏览器打开当前图表",
        "shortTitle": "在浏览器打开当前图表",
        "icon": "$(link-external)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.search",
        "title": "全球指数：搜索并添加指数",
        "icon": "$(search)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.refresh",
        "title": "全球指数：立即刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.togglePause",
        "title": "全球指数：暂停 / 恢复自动刷新",
        "icon": "$(debug-pause)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.open",
        "title": "全球指数：在浏览器查看指数详情",
        "icon": "$(link-external)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.add",
        "title": "全球指数：添加指数（名称 / 代码）",
        "icon": "$(add)"
      },
      {
        "command": "welove42.aShareTurnover.globalIndices.remove",
        "title": "全球指数：删除指数",
        "icon": "$(trash)"
      },
      {
        "command": "welove42.aShareTurnover.funds.add",
        "title": "基金：按名称或代码添加基金",
        "icon": "$(add)"
      },
      {
        "command": "welove42.aShareTurnover.funds.refresh",
        "title": "基金：立即刷新净值 / 估算",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.funds.togglePause",
        "title": "基金：暂停 / 恢复自动检查",
        "icon": "$(debug-pause)"
      },
      {
        "command": "welove42.aShareTurnover.funds.remove",
        "title": "基金：移出列表（保留持仓记录）",
        "icon": "$(trash)"
      },
      {
        "command": "welove42.aShareTurnover.funds.editHolding",
        "title": "基金：设置持仓份额和总成本",
        "icon": "$(edit)"
      },
      {
        "command": "welove42.aShareTurnover.funds.clearHolding",
        "title": "基金：清除本机持仓（保留关注）",
        "icon": "$(clear-all)"
      },
      {
        "command": "welove42.aShareTurnover.funds.open",
        "title": "基金：在浏览器查看基金详情",
        "icon": "$(link-external)"
      },
      {
        "command": "welove42.aShareTurnover.commodities.add",
        "title": "全球商品：按名称或代码添加商品",
        "icon": "$(add)"
      },
      {
        "command": "welove42.aShareTurnover.commodities.remove",
        "title": "全球商品：移除商品",
        "icon": "$(trash)"
      },
      {
        "command": "welove42.aShareTurnover.commodities.refresh",
        "title": "全球商品：立即刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "welove42.aShareTurnover.commodities.togglePause",
        "title": "全球商品：暂停 / 恢复自动刷新",
        "icon": "$(debug-pause)"
      },
      {
        "command": "welove42.aShareTurnover.commodities.open",
        "title": "全球商品：在浏览器查看商品详情",
        "icon": "$(link-external)"
      },
      {
        "command": "welove42.aShareTurnover.sectors.refresh",
        "title": "牛来盯盘：刷新板块排行"
      },
      {
        "command": "welove42.aShareTurnover.sectors.menu",
        "title": "牛来盯盘：切换板块排行"
      },
      {
        "command": "welove42.aShareTurnover.stockGroups.create",
        "title": "自选股：新建分组",
        "icon": "$(new-folder)",
        "enablement": "!aShareTurnover.hidden"
      },
      {
        "command": "welove42.aShareTurnover.stockGroups.rename",
        "title": "自选股：重命名分组",
        "icon": "$(edit)",
        "enablement": "!aShareTurnover.hidden"
      },
      {
        "command": "welove42.aShareTurnover.stockGroups.remove",
        "title": "自选股：删除分组（保留个股）",
        "icon": "$(trash)",
        "enablement": "!aShareTurnover.hidden"
      },
      {
        "command": "welove42.aShareTurnover.stockGroups.move",
        "title": "自选股：移动到分组",
        "icon": "$(arrow-swap)",
        "enablement": "!aShareTurnover.hidden"
      },
      {
        "command": "welove42.aShareTurnover.stockGroups.add",
        "title": "自选股：添加个股到此分组",
        "icon": "$(add)",
        "enablement": "!aShareTurnover.hidden"
      },
      {
        "command": "welove42.aShareTurnover.ai.open",
        "title": "牛来盯盘：AI 分析个股 / ETF",
        "icon": "$(sparkle)"
      },
      {
        "command": "welove42.aShareTurnover.ai.market",
        "title": "牛来盯盘：AI 分析大盘",
        "icon": "$(sparkle)"
      },
      {
        "command": "welove42.aShareTurnover.ai.chart",
        "title": "AI 分析当前个股",
        "icon": "$(sparkle)"
      }
    ],
    "configuration": {
      "title": "牛来盯盘",
      "properties": {
        "aShareTurnover.stockAlerts.mode": {
          "type": "string",
          "enum": [
            "always",
            "never",
            "whenVisible"
          ],
          "enumDescriptions": [
            "一直提醒",
            "一直不提醒",
            "老板键激活时不提醒"
          ],
          "default": "whenVisible",
          "scope": "application",
          "description": "自选个股涨幅超过7%或跌幅超过7%时弹窗提醒，覆盖A股、港股和美股。当天同一股票同一方向只提醒一次。一直提醒模式在老板键开启时仍监测；关闭自选行情或暂停刷新时停止监测。"
        },
        "aShareTurnover.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "在底部状态栏显示沪深 A 股成交额。"
        },
        "aShareTurnover.comparisonMode": {
          "type": "string",
          "enum": [
            "sameTime",
            "previousDay"
          ],
          "default": "sameTime",
          "scope": "application",
          "enumDescriptions": [
            "与上一交易日相同分钟的累计成交额比较。",
            "与上一交易日全天成交额比较，明确标注较昨全天。"
          ],
          "description": "状态栏的缩量 / 放量比较口径。"
        },
        "aShareTurnover.showDifferenceAmount": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "在状态栏百分比后同时显示增加 / 减少的成交额。"
        },
        "aShareTurnover.colorMode": {
          "type": "string",
          "enum": [
            "neutral",
            "redUpGreenDown"
          ],
          "default": "neutral",
          "scope": "application",
          "enumDescriptions": [
            "使用默认状态栏颜色。",
            "放量红色，缩量绿色。"
          ],
          "description": "成交额常规颜色；开启超过阈值变色后，达到变色条件时优先使用提醒颜色。"
        },
        "aShareTurnover.additionalClosedDates": {
          "type": "array",
          "default": [],
          "scope": "application",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "description": "额外休市日期（YYYY-MM-DD），用于补充未来年份或临时休市。内置 2026 年交易所节假日。周末始终休市，不跟随调休补班。"
        },
        "aShareTurnover.reminders.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "在状态栏显示最近的财经大事，点击查看完整日历。"
        },
        "aShareTurnover.reminders.notifications": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "在事件前 24 小时及 30 分钟内显示一次提醒；VS Code 未运行时不会发送。"
        },
        "aShareTurnover.reminders.categories": {
          "type": "array",
          "scope": "application",
          "uniqueItems": true,
          "default": [
            "fed",
            "delivery",
            "cnHoliday",
            "hkHoliday",
            "usHoliday",
            "nonfarm",
            "cpi"
          ],
          "items": {
            "type": "string",
            "enum": [
              "fed",
              "delivery",
              "cnHoliday",
              "hkHoliday",
              "usHoliday",
              "nonfarm",
              "cpi"
            ],
            "enumDescriptions": [
              "美联储议息",
              "A股股指期货交割",
              "A股节假日",
              "港股节假日及半日市",
              "美股节假日及提前收盘",
              "美国非农",
              "美国 CPI"
            ]
          },
          "description": "选择需要显示和提醒的大事类型，删除数组中的类型即可关闭。"
        },
        "aShareTurnover.stocks.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "显示自选股侧栏及底部指数/个股行情，与原成交额状态栏独立。"
        },
        "aShareTurnover.stocks.colorMode": {
          "type": "string",
          "default": "redUpGreenDown",
          "scope": "application",
          "enum": [
            "redUpGreenDown",
            "neutral",
            "custom"
          ],
          "enumDescriptions": [
            "红涨绿跌",
            "跟随主题（不区分涨跌颜色）",
            "自定义上涨和下跌颜色"
          ],
          "description": "自选股列表箭头和底部股票行情的配色，适用于 A 股、港股和美股自选。"
        },
        "aShareTurnover.stocks.upColor": {
          "type": "string",
          "default": "#f14c4c",
          "scope": "application",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "patternErrorMessage": "请填写六位 HEX 颜色，例如 #f14c4c。",
          "description": "自定义上涨颜色，仅在自选配色选择自定义时生效。也可在插件设置页用颜色选择器调整。"
        },
        "aShareTurnover.stocks.downColor": {
          "type": "string",
          "default": "#55b873",
          "scope": "application",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "patternErrorMessage": "请填写六位 HEX 颜色，例如 #55b873。",
          "description": "自定义下跌颜色，仅在自选配色选择自定义时生效。也可在插件设置页用颜色选择器调整。"
        },
        "aShareTurnover.stocks.symbols": {
          "type": "array",
          "default": [],
          "scope": "application",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "自选代码，最多100个。点击添加可按中文名、拼音或编号搜索；设置中保存完整代码，如 sh600519、sz000001、bj920002。"
        },
        "aShareTurnover.stocks.statusBarSymbol": {
          "type": "string",
          "default": "sh000001",
          "scope": "application",
          "description": "底部显示的代码，默认上证指数；其他代码须已加入自选。点击底部行情可切换，删除已选个股后自动回到上证指数。"
        },
        "aShareTurnover.stocks.hkSymbols": {
          "type": "array",
          "default": [],
          "scope": "application",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "港股自选代码，例如 hk00700；也可使用港股分组旁的＋按名称或代码添加。"
        },
        "aShareTurnover.stocks.usSymbols": {
          "type": "array",
          "default": [],
          "scope": "application",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "美股自选代码，例如 usAAPL、usTSLA、usBRK.B。支持名称搜索、分组和拖拽；列表按常规、盘前、盘后时段显示价格及涨跌幅，悬停查看各时段、基准价和美东时间。"
        },
        "aShareTurnover.stocks.sortBy": {
          "type": "string",
          "enum": [
            "manual",
            "percentDesc",
            "percentAsc"
          ],
          "default": "manual",
          "scope": "application",
          "enumDescriptions": [
            "手动顺序（可拖拽）",
            "涨幅从高到低",
            "跌幅从大到小"
          ],
          "description": "自选股列表排序；拖拽个股会保存手动顺序并自动切换到手动排序。"
        },
        "aShareTurnover.charts.defaultMode": {
          "type": "string",
          "enum": [
            "intraday",
            "intraday5",
            "m1",
            "m5",
            "m15",
            "m30",
            "m60",
            "daily",
            "weekly",
            "monthly",
            "eastmoney",
            "chips"
          ],
          "default": "intraday",
          "scope": "application",
          "enumDescriptions": [
            "内置分时图，直接绘制价格、成交量及技术指标。",
            "内置最近5个交易日分时图，按日显示成交均价和技术指标。",
            "内置1分钟K线。",
            "内置5分钟K线。",
            "内置15分钟K线。",
            "内置30分钟K线。",
            "内置60分钟K线。",
            "内置日K、均线及技术指标。",
            "内置周K、均线及技术指标。",
            "内置月K、均线及技术指标。",
            "东方财富常规网页图表，可能要求验证码。",
            "东方财富筹码盘口网页，可能要求验证码；不支持的品种使用内置分时。"
          ],
          "description": "新打开详情标签的默认图表。已有标签切换股票时保留当前类型；可用编辑器右上角切换图表。"
        },
        "aShareTurnover.news.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "启用底部输出面板财经快讯及新闻状态栏入口。"
        },
        "aShareTurnover.news.refreshIntervalSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 10,
          "maximum": 300,
          "scope": "application",
          "description": "7×24快讯刷新间隔（秒），休市期间也刷新。支持暂停，默认不弹出桌面通知。"
        },
        "aShareTurnover.globalIndices.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "显示自选股下方的全球指数栏目。默认仅纳斯达克综合、日经225和韩国KOSPI，其他指数通过＋添加；栏目可见时每10秒刷新所选指数，主源失败自动回退，全源失败逐步退避；不受A股交易时段限制。"
        },
        "aShareTurnover.globalIndices.symbols": {
          "type": "array",
          "default": [
            "100.NDX",
            "100.N225",
            "100.KS11"
          ],
          "scope": "application",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:100\\.)?[A-Za-z][A-Za-z0-9]{0,19}$"
          },
          "description": "全球指数显示列表，按添加顺序排列。点击栏目＋搜索名称或代码添加，行末垃圾桶删除；也可填代码如 NDX、N225、KS11、100.SPX。空数组表示不显示任何指数。"
        },
        "aShareTurnover.funds.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "显示基金折叠栏目。自动展示有效盘中估算或已公布净值，支持本机持仓收益；可见时每60秒检查。"
        },
        "aShareTurnover.funds.estimateEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "有有效盘中估值时显示估算涨跌、净值和持仓收益；正式净值公布后自动切回。估值缺失或过期时显示正式净值，估算不代表实际收益。列表可见时每60秒检查。"
        },
        "aShareTurnover.funds.symbols": {
          "type": "array",
          "default": [],
          "scope": "application",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "description": "关注的六位基金代码，默认不预置基金；可通过＋按名称或代码搜索添加。持仓份额与成本保存在本机扩展存储，不写入此设置。"
        },
        "aShareTurnover.commodities.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "显示全球商品折叠栏目，展开时每10秒获取新浪财经CFD参考行情，不受A股开盘时间限制。"
        },
        "aShareTurnover.commodities.symbols": {
          "type": "array",
          "default": [
            "XAU",
            "OIL",
            "CAD",
            "XAG"
          ],
          "scope": "application",
          "uniqueItems": true,
          "maxItems": 14,
          "items": {
            "type": "string"
          },
          "description": "默认仅伦敦金、布伦特原油、伦敦铜、伦敦银，顺序按此列表保存。点击＋可按名称、拼音简称或代码从支持的商品目录添加其他品种；代码支持XAU或hf_XAU格式。空数组保持空列表。"
        },
        "aShareTurnover.temperature.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "底部显示沪深A股市场温度（0–100）：涨跌家数60%、两市A股指数平均涨跌幅25%、昨日同刻成交额变化15%。复用成交额行情每10秒更新；属于自定义情绪指标，依赖成交额模块。"
        },
        "aShareTurnover.temperature.colorize": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "市场温度使用主题颜色：偏热/过热为红色，偏冷/冰点为蓝色，中性及无有效评分时使用默认颜色。"
        },
        "aShareTurnover.risk.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "状态栏显示基于沪深成交额较昨同刻与上证指数跌幅的风险提示；依赖成交额及自选股行情模块。"
        },
        "aShareTurnover.risk.volumePercent": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 1000,
          "scope": "application",
          "description": "触发放量或缩量下跌提示所需的同刻成交额变化绝对值（百分比）。"
        },
        "aShareTurnover.risk.dropPercent": {
          "type": "number",
          "default": 1.5,
          "minimum": 0.1,
          "maximum": 100,
          "scope": "application",
          "description": "触发提示所需的上证指数跌幅（百分比）。"
        },
        "aShareTurnover.sectors.enabled": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示所选涨幅榜或跌幅榜第一名，悬停查看前十，点击切换榜单。"
        },
        "aShareTurnover.sectors.category": {
          "type": "string",
          "enum": [
            "industry",
            "concept"
          ],
          "enumDescriptions": [
            "行业板块",
            "概念板块"
          ],
          "default": "industry",
          "description": "状态栏板块涨幅排行类型。东方财富不可用时，概念榜使用新浪备用参考并标注口径。"
        },
        "aShareTurnover.sectors.direction": {
          "type": "string",
          "enum": [
            "gainers",
            "losers"
          ],
          "enumDescriptions": [
            "涨幅前十",
            "跌幅前十"
          ],
          "default": "gainers",
          "description": "板块榜单方向。涨幅榜按涨跌幅从高到低，跌幅榜从低到高；可直接点击底部板块行情切换，行业和概念板块均支持。"
        },
        "aShareTurnover.stocks.groups": {
          "type": "array",
          "default": [],
          "scope": "application",
          "maxItems": 30,
          "description": "A 股自定义分组。可在侧栏或插件设置页管理；每只个股只属于一个分组，未归类个股自动显示在未分组。删除分组保留个股。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "symbols"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][\\w-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "symbols": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "aShareTurnover.stocks.hkGroups": {
          "type": "array",
          "default": [],
          "scope": "application",
          "maxItems": 30,
          "description": "港股自定义分组。可在侧栏或插件设置页管理；每只个股只属于一个分组，未归类个股自动显示在未分组。删除分组保留个股。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "symbols"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][\\w-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "symbols": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "aShareTurnover.stocks.usGroups": {
          "type": "array",
          "default": [],
          "scope": "application",
          "maxItems": 30,
          "description": "美股自定义分组。可在侧栏或插件设置页管理；每只个股只属于一个分组，未归类个股自动显示在未分组。删除分组保留个股。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "symbols"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][\\w-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "symbols": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "aShareTurnover.turnoverAlerts.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "大盘成交额放量或缩量严格超过阈值时弹窗，每天每个方向只提醒一次，重启保留记录；老板键、暂停、关闭成交额或行情过期时不提醒。"
        },
        "aShareTurnover.turnoverAlerts.percent": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "scope": "application",
          "description": "大盘放量 / 缩量的弹窗和变色阈值（%），沿用状态栏的比较口径，默认对比上一交易日同刻。"
        },
        "aShareTurnover.turnoverAlerts.colorize": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "超过阈值时状态栏成交额一栏放量红色、缩量绿色；回到阈值内恢复常规颜色设置。独立于弹窗开关。"
        },
        "aShareTurnover.ai.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "maxLength": 2048,
          "description": "AI 分析的 Chat Completions 兼容 API 地址，例如 https://api.deepseek.com 或 https://api.example.com/v1。Key 请在插件设置页安全保存。"
        },
        "aShareTurnover.ai.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "maxLength": 160,
