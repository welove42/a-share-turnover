    "keybindings": [
      {
        "command": "welove42.aShareTurnover.toggleHidden",
        "key": "ctrl+shift+;"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "welove42Workspace",
          "title": "工作台",
          "icon": "media/market.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "welove42Analysis",
          "title": "分析",
          "icon": "media/ai.svg"
        }
      ]
    },
    "views": {
      "welove42Workspace": [
        {
          "id": "welove42.aShareTurnover.marketWatch",
          "name": "自选股（名称 / 代码）",
          "contextualTitle": "工作台",
          "when": "!aShareTurnover.hidden"
        },
        {
          "id": "welove42.aShareTurnover.globalIndices",
          "name": "全球指数",
          "contextualTitle": "STOCK 全球指数",
          "when": "!aShareTurnover.hidden && config.aShareTurnover.globalIndices.enabled"
        },
        {
          "id": "welove42.aShareTurnover.funds",
          "name": "基金",
          "contextualTitle": "STOCK 基金",
          "when": "!aShareTurnover.hidden && config.aShareTurnover.funds.enabled"
        },
        {
          "id": "welove42.aShareTurnover.commodities",
          "name": "全球商品",
          "contextualTitle": "STOCK 全球商品",
          "when": "!aShareTurnover.hidden && config.aShareTurnover.commodities.enabled"
        },
        {
          "type": "webview",
          "id": "welove42.aShareTurnover.debugCover",
          "name": "运行和调试",
          "contextualTitle": "工作台",
          "when": "aShareTurnover.hidden"
        }
      ],
      "welove42Analysis": [
        {
          "id": "welove42.aShareTurnover.aiAnalysis",
          "name": "AI 分析",
          "type": "webview",
          "when": "!aShareTurnover.hidden",
          "icon": "media/ai.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "welove42.aShareTurnover.marketWatch",
        "contents": "输入中文名、拼音或股票代码搜索添加自选股。\n[搜索并添加自选股](command:welove42.aShareTurnover.stocks.add)\n点击个股查看东方财富详细行情及分时 / 日K图。\n[财经新闻（底部输出面板）](command:welove42.aShareTurnover.news.show)\n底部默认显示上证指数，点击可切换。",
        "when": "!aShareTurnover.hidden && config.aShareTurnover.stocks.enabled"
      },
      {
        "view": "welove42.aShareTurnover.marketWatch",
        "contents": "自选行情已禁用，请在用户设置中开启 aShareTurnover.stocks.enabled。",
        "when": "!aShareTurnover.hidden && !config.aShareTurnover.stocks.enabled"
      },
      {
        "view": "welove42.aShareTurnover.funds",
        "contents": "添加基金查看盘中估算和已公布净值。\n[按名称或代码添加基金](command:welove42.aShareTurnover.funds.add)\n行末铅笔可设置份额和成本，查看持仓收益。\n估算会明确标注，不代表实际收益；持仓只保存在本机。",
        "when": "!aShareTurnover.hidden && config.aShareTurnover.funds.enabled"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "welove42.aShareTurnover.settings.open",
          "when": "!aShareTurnover.hidden && view == welove42.aShareTurnover.marketWatch",
          "group": "navigation@4"
        },
        {
          "command": "welove42.aShareTurnover.stocks.add",
          "when": "!aShareTurnover.hidden && (view == welove42.aShareTurnover.marketWatch)",
          "group": "navigation@0"
        },
        {
          "command": "welove42.aShareTurnover.stocks.refresh",
          "when": "!aShareTurnover.hidden && (view == welove42.aShareTurnover.marketWatch)",
          "group": "navigation@1"
        },
        {
          "command": "welove42.aShareTurnover.stocks.sort",
          "when": "!aShareTurnover.hidden && (view == welove42.aShareTurnover.marketWatch)",
          "group": "navigation@2"
        },
        {
          "command": "welove42.aShareTurnover.stocks.togglePause",
          "when": "!aShareTurnover.hidden && (view == welove42.aShareTurnover.marketWatch)",
          "group": "navigation@3"
        },
        {
          "command": "welove42.aShareTurnover.news.show",
