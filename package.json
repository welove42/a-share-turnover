          "group": "navigation@2"
        },
        {
          "command": "welove42.aShareTurnover.commodities.add",
          "when": "!aShareTurnover.hidden && (view == welove42.aShareTurnover.commodities)",
          "group": "navigation@0"
        },
        {
          "command": "welove42.aShareTurnover.commodities.refresh",
